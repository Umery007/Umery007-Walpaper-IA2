# ---------------------------------------------------------------
# WA1PAPER API - copie este arquivo para ".env" e preencha os valores
# ---------------------------------------------------------------

# Porta e endereco publico da API
PORT=4000
PUBLIC_URL=http://localhost:4000

# Endereco do frontend (Vite). Usado para CORS e para os links de e-mail.
FRONTEND_URL=http://localhost:5173

# PostgreSQL -----------------------------------------------------
# EMBEDDED_POSTGRES=true sobe um PostgreSQL proprio a partir dos binarios
# instalados pelo npm, guardando os dados em back/.pgdata. Nao precisa
# instalar nada nem ser administrador.
#
# Para usar um PostgreSQL seu (instalado na maquina ou na nuvem), coloque
# EMBEDDED_POSTGRES=false e ajuste a DATABASE_URL abaixo.
EMBEDDED_POSTGRES=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/wa1paper
# Use "true" quando o banco exigir SSL (Render, Railway, Supabase, Neon...)
DATABASE_SSL=false

# Autenticacao ---------------------------------------------------
# Gere um valor longo e aleatorio. Ex.: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Google Gemini (geracao de imagens) -----------------------------
# IA (Google Gemini) ---------------------------------------------
# GEMINI_PROVIDER escolhe de onde sai a cobranca:
#   vertex   -> aiplatform.googleapis.com, cobra dos creditos do Google Cloud.
#               A chave vem do console do Cloud (Agent Platform > Chaves de API).
#   aistudio -> generativelanguage.googleapis.com, cobra do saldo pre-pago do
#               AI Studio, que NAO usa os creditos do Cloud.
# Uma chave de um provedor da 403 no outro: troque os dois juntos.
GEMINI_PROVIDER=vertex
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Mercado Pago (opcional: checkout de planos e creditos) ----------
# Sem este valor as rotas de checkout respondem com um erro explicando
# que o pagamento ainda nao foi configurado. O resto da API funciona.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
